# =============================================
# Innermark Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control!

# --- Supabase ---
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Stripe ---
# Get from Stripe Dashboard > Developers > API Keys
VITE_STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key-here

# Stripe Price IDs — create these in Stripe Dashboard > Products
VITE_STRIPE_PRICE_MONTHLY=price_your-monthly-price-id
VITE_STRIPE_PRICE_YEARLY=price_your-yearly-price-id

# --- Optional: Stripe webhook secret (for backend verification) ---
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- App ---
# Set to your deployed URL for PWA and OAuth callbacks
VITE_APP_URL=https://yourapp.com
